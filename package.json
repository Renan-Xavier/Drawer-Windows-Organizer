{
  "name": "drawer",
  "productName": "Drawer",
  "version": "2.0.0",
  "description": "Drawer 2.0 — Pods Nativos Independentes & Bordas Magnéticas para Windows (C# / WPF DirectX + Win32 Shell COM)",
  "main": "src/main/build-native.js",
  "author": "Renan Santa Rosa Xavier",
  "license": "MIT",
  "scripts": {
    "start": "node src/main/build-native.js && cmd /c start \"\" \"dist\\Drawer.exe\"",
    "test": "node src/main/build-native.js && node --test tests/*.test.js",
    "icons": "node src/main/icon-generator.js",
    "build:native": "node src/main/build-native.js",
    "dist": "node src/main/build-native.js",
    "install:local": "node src/main/build-native.js && dist\\Drawer-Setup-2.0.0.exe --silent"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
